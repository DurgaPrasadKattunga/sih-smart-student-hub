# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Replace all values with your production URLs and credentials

# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV=production

# ============================================
# Frontend URLs (Replace with your domain)
# ============================================
FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN.com

# ============================================
# CORS Origins - IMPORTANT!
# ============================================
# List all your frontend domains (comma-separated)
# Examples:
# - https://yourapp.vercel.app
# - https://yourapp.onrender.com
# - https://app.yourdomain.com
# - https://www.yourdomain.com
ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN.com

# ============================================
# Database Configuration
# ============================================
# Get from MongoDB Atlas (mongodb+srv://...)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME

# ============================================
# JWT & Session Security - GENERATE NEW SECURE VALUES!
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERATE_NEW_SECURE_RANDOM_STRING_MIN_32_CHARACTERS
SESSION_SECRET=GENERATE_NEW_DIFFERENT_SECURE_RANDOM_STRING_MIN_32_CHARACTERS

# ============================================
# Cloudinary Configuration (File Upload)
# ============================================
# Get from https://cloudinary.com/console/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# Microsoft OAuth 2.0 Configuration
# ============================================
# Register at: https://portal.azure.com
# Update Redirect URI to: https://YOUR_BACKEND_DOMAIN.com/auth/microsoft/callback
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_CALLBACK_URL=https://YOUR_BACKEND_DOMAIN.com/auth/microsoft/callback
