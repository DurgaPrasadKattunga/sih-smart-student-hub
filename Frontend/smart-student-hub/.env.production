# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Vite environment variables must start with VITE_

# ============================================
# Backend API Configuration
# ============================================
# CRITICAL: Replace with your actual production backend domain
# Examples:
# - https://api.yourdomain.com
# - https://your-backend.onrender.com
# - https://your-app-backend.herokuapp.com
# - https://your-domain.com/api

# GET YOUR BACKEND URL FROM YOUR HOSTING PROVIDER:
VITE_API_URL=https://YOUR_BACKEND_DOMAIN.com

# ============================================
# Environment
# ============================================
VITE_ENV=production

# ============================================
# Setup Instructions
# ============================================
# 1. Replace YOUR_BACKEND_DOMAIN.com with your actual backend URL
# 2. Run: npm run build
# 3. Deploy dist/ folder to your hosting provider
# 4. Ensure your backend CORS includes this frontend domain
#
# Example for production:
# VITE_API_URL=https://api.smartstudenthub.com

